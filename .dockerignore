# Keep the build context small and, more importantly, keep host build artefacts
# (macOS/arm64 node_modules, .next, dist) out of the Linux images.

**/node_modules
**/.next
**/dist
**/build
**/out
**/*.tsbuildinfo

.git
.gitignore
.github

# Local environment files and secrets — never bake these into an image.
**/.env
**/.env.*
!**/.env.example

# Local npm cache and tooling
.npm-cache
.vscode
.zed
.agents
.idea

# Docs / specs not needed to build
openspec
**/*.md

# OS noise
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
