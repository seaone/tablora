# Copy to deploy/.env and fill in real values:
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored — never commit it.

# Public URL users open in the browser (the domain your reverse proxy serves).
# This is baked into the browser bundle at BUILD time — changing it requires a
# rebuild (CI does that for you; rebuild the frontend image after changing the
# repository variable PUBLIC_URL).
PUBLIC_URL=https://tablora.example.com

# Registry namespace the images are pulled from. CI publishes to
# ghcr.io/<repository-owner>/tablora-{backend,frontend}, so set this to
# ghcr.io/<repository-owner>.
TABLORA_IMAGE_PREFIX=ghcr.io/your-org

# Which published image to run. `latest` follows the main branch. To roll back,
# pin an immutable build instead, e.g. TABLORA_IMAGE_TAG=sha-<full-commit-sha>.
TABLORA_IMAGE_TAG=latest

# PostgreSQL credentials. Use a password without special characters that would
# break the DATABASE_URL connection string (letters, digits, - and _ are safe).
POSTGRES_USER=tablora
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=tablora

# Host directory holding the PostgreSQL data. It must already exist, and it must be
# owned by uid 999 — the `postgres` user inside the image:
#   mkdir -p <dir>/postgres && chown 999:999 <dir>/postgres
# On a host using unprivileged containers the uid is offset (100000 + 999).
TABLORA_DATA_DIR=/var/lib/tablora

# ── Authentication (Yandex ID) ───────────────────────────────────────────────
# Register an OAuth app at https://oauth.yandex.ru/. It must list a redirect URI
# equal to YANDEX_REDIRECT_URI below.
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret

# Public origin of the web UI: the allowed CORS origin and the post-login redirect
# target. For a single-domain deployment this equals PUBLIC_URL.
FRONTEND_URL=https://tablora.example.com

# Redirect URI registered in the Yandex app. Must be <PUBLIC_URL>/api/auth/yandex/callback.
YANDEX_REDIRECT_URI=https://tablora.example.com/api/auth/yandex/callback

# Secret used to sign session cookies. Use a long random value; rotating it signs
# everyone out.
AUTH_JWT_SECRET=change_me_to_a_long_random_secret
