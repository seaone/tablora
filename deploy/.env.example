# Copy to deploy/.env and fill in real values:
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored — never commit it.

# Public URL users open in the browser (the domain your reverse proxy serves).
# This is baked into the browser bundle at BUILD time, so after changing it you
# must rebuild the frontend:  docker compose -f deploy/docker-compose.yml build frontend
PUBLIC_URL=https://tablora.example.com

# PostgreSQL credentials. Use a password without special characters that would
# break the DATABASE_URL connection string (letters, digits, - and _ are safe).
POSTGRES_USER=tablora
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=tablora

# Host directory holding the PostgreSQL data. It must already exist, and it must be
# owned by uid 999 — the `postgres` user inside the image:
#   mkdir -p <dir>/postgres && chown 999:999 <dir>/postgres
# On a host using unprivileged containers the uid is offset (100000 + 999).
TABLORA_DATA_DIR=/var/lib/tablora
