PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://tablora:tablora_password@localhost:5432/tablora

# Origin of the frontend app. Used for CORS (with credentials) and as the default
# post-login redirect target.
FRONTEND_URL=http://localhost:3000

# Yandex ID OAuth application. Create one at https://oauth.yandex.ru/ and register a
# redirect URI that matches YANDEX_REDIRECT_URI exactly.
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=http://localhost:4000/api/auth/yandex/callback

# Secret used to sign session cookies. Use a long random value; changing it signs
# everyone out.
AUTH_JWT_SECRET=change_me_to_a_long_random_secret

